{
  "name": "codevivo-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_DISABLE_TURBOPACK=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/db-migrate.mjs",
    "discovery:admin": "node --import tsx scripts/discovery-admin.ts",
    "test:db": "node --test tests/database/*.test.mjs",
    "test:m2a": "node --import tsx --test tests/discovery/credentials.test.ts tests/discovery/isolation-headers.test.ts tests/discovery/session-security.test.ts",
    "test:m2b:database": "node --import tsx --test tests/discovery/invitation-live.test.ts",
    "test:m2b:upstash": "node --env-file=.env.local --import tsx --test tests/discovery/upstash-live.test.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@next/third-parties": "^16.4.1",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/components": "^1.0.9",
    "@react-email/render": "^2.0.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@svgr/webpack": "^8.1.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.577.0",
    "next": "^16.4.1",
    "next-intl": "^4.14.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.3",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/webpack": "^4.41.40",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
