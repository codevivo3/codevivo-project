{
  "name": "codevivo-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_DISABLE_TURBOPACK=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/db-migrate.mjs",
    "discovery:admin": "node --import tsx scripts/discovery-admin.ts",
    "discovery:recovery": "node --import tsx scripts/discovery-recovery-executor.ts",
    "discovery:verify-pepper": "node --import tsx scripts/discovery-verify-pepper.ts",
    "discovery:phase2:validate": "node --import tsx scripts/discovery-phase2-validation.ts",
    "discovery:validation:preflight": "node --import tsx scripts/discovery-permanent-validation-preflight.ts",
    "discovery:validation:migrate": "node --import tsx scripts/discovery-permanent-validation-migration.ts",
    "test:db": "node --test tests/database/*.test.mjs",
    "test:db:recovery": "node --import tsx scripts/discovery-recovery-test.ts",
    "test:recovery": "node --import tsx --test tests/discovery/recovery-executor.test.ts tests/discovery/recovery-test-guard.test.ts",
    "test:contact": "node --import tsx --test tests/contact/*.test.ts",
    "test:contact:live": "node --import tsx --test tests/contact/contact-repository-live.test.ts",
    "test:contact:outbox:live": "node --import tsx --test tests/contact/contact-outbox-live.test.ts",
    "test:m2a": "node --import tsx --test tests/discovery/admin-cli-validation.test.ts tests/discovery/credentials.test.ts tests/discovery/isolation-headers.test.ts tests/discovery/recovery-test-guard.test.ts tests/discovery/session-security.test.ts",
    "test:discovery:drafts": "node --import tsx --test tests/discovery/draft-*.test.ts tests/discovery/admin-prefill.test.ts tests/discovery/phase2-validation-guard.test.ts",
    "test:discovery:drafts:live": "node --import tsx --test tests/discovery/draft-live.test.ts",
    "test:discovery:submission:live": "node --import tsx --test tests/discovery/submission-live.test.ts",
    "test:discovery:notifications": "node --import tsx --test tests/discovery/notification-*.test.ts",
    "test:discovery:validation-preflight": "node --import tsx --test tests/discovery/permanent-validation-preflight.test.ts",
    "test:discovery:validation-migration": "node --import tsx --test tests/discovery/permanent-validation-migration.test.ts",
    "test:m2b:database": "node --import tsx --test tests/discovery/invitation-live.test.ts",
    "test:m2b:upstash": "node --env-file=.env.local --import tsx --test tests/discovery/upstash-live.test.ts"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.2",
    "@neondatabase/serverless": "^1.2.0",
    "@next/third-parties": "^16.4.6",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/components": "^1.0.9",
    "@react-email/render": "^2.0.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@svgr/webpack": "^8.1.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.34.3",
    "libphonenumber-js": "^1.13.17",
    "lucide-react": "^0.577.0",
    "next": "^16.4.6",
    "next-intl": "^4.14.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.3",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/webpack": "^4.41.40",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
