# Local development
NEXT_DISABLE_TURBOPACK=1

# Existing contact form infrastructure
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Project Discovery application runtime
# Use Neon's pooled connection string for deployed application traffic.
DATABASE_URL=
# A high-entropy secret of at least 32 bytes. Emergency rotation invalidates
# all active invitation links and discovery sessions in V1.
DISCOVERY_TOKEN_PEPPER=
DISCOVERY_BASE_URL=http://localhost:3000
DISCOVERY_NOTIFICATION_TO=hello@codevivo.dev

# Project Discovery retention policy
DISCOVERY_ABANDONED_RETENTION_DAYS=30
DISCOVERY_SUBMITTED_RETENTION_DAYS=730

# Local administrative and migration processes only.
# Supply these at process launch from macOS Keychain; never configure them
# in the deployed application or commit populated values.
DISCOVERY_ADMIN_DATABASE_URL=
DISCOVERY_MIGRATION_DATABASE_URL=
DISCOVERY_DB_TEST_ALLOW=0
DISCOVERY_M2B_LIVE_ALLOW=0
DISCOVERY_UPSTASH_TEST_ALLOW=0
